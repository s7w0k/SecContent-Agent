# ═══════════════════════════════════════════════════════════
# PR Agent Demo — 环境变量模板
# ═══════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ⚠️  .env 已在 .gitignore 中，不会被提交到仓库
# ═══════════════════════════════════════════════════════════

# ── LLM 配置（必填）──────────────────────────────
# DeepSeek API Key（获取地址: https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── MongoDB ──────────────────────────────────────
# MongoDB root 密码（生产环境请更换强密码）
MONGO_ROOT_PASSWORD=pr_agent_2024
# 连接 URI（Docker Compose 自动生成，一般无需修改）
# MONGODB_URI=mongodb://admin:pr_agent_2024@mongodb:27017

# ── mcp-wewe 微信公众号 RSS（必填）───────────────
# WeWe RSS 服务地址
WEWE_RSS_URL=http://your-wewe-rss:4000
# WeWe RSS 认证码
WEWE_AUTH_CODE=your-auth-code-here

# ── mcp-crawl 海外安全新闻 ───────────────────────
# Tavily Search API Key（获取地址: https://tavily.com）
TAVILY_API_KEY=tvly-your-tavily-key-here

# ── 服务端口（可选，以下为默认值）────────────────
BACKEND_PORT=8000
# MCP_WEWE_URL=http://mcp-wewe:8100
# MCP_CRAWL_URL=http://mcp-crawl:8101

# ── 流水线配置（可选）────────────────────────────
# 触发 PR 报道的综合分阈值 (0-200)
PIPELINE_SCORE_THRESHOLD=140
# 默认爬取天数
PIPELINE_CRAWL_DEFAULT_DAYS=1
