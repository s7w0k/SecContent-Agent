# ═══════════════════════════════════════════════════════════
# PR Agent Demo — 环境变量模板
# ═══════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ⚠️  .env 已在 .gitignore 中，不会被提交到仓库
# ═══════════════════════════════════════════════════════════

# ── LLM 配置（必填）──────────────────────────────
# DeepSeek API Key（获取地址: https://platform.deepseek.com/api_keys）
# 草稿生成、改稿及内容与宣传话术检查共用以下配置，无需额外审核变量。
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
#
# 单篇首稿默认只生成 1 个版本；需要备选稿时可在界面选择 2/4。
# 草稿使用独立输出上限，避免继承全局 8192 token。
DRAFT_MAX_OUTPUT_TOKENS=1800
SINGLE_ARTICLE_DRAFT_VARIANTS=1

# ── JWT 认证（必填）────────────────────────────────
# 生产环境请替换为随机生成的 32 字符以上强密钥，禁止使用此占位值
JWT_SECRET=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── MongoDB ──────────────────────────────────────
# MongoDB root 密码（生产环境请更换强密码）
MONGO_ROOT_PASSWORD=pr_agent_2024
# 连接 URI（Docker Compose 自动生成，一般无需修改）
# MONGODB_URI=mongodb://admin:pr_agent_2024@mongodb:27017

# Redis / ARQ task queue (stage 9)
# Use the service name "redis" in Docker Compose; use 127.0.0.1 for local Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
# Leave empty when Redis authentication is disabled.
REDIS_PASSWORD=

# Maximum jobs executed concurrently by one worker.
ARQ_MAX_JOBS=3
# Per-job timeout in seconds.
ARQ_JOB_TIMEOUT=600
# Maximum retries after a job failure.
ARQ_MAX_RETRIES=3

# ── 海外新闻每日定时抓取（阶段十六）─────────────────
# 是否启用每日定时抓取
OVERSEAS_NEWS_SCHEDULE_ENABLED=true
# 业务时区（IANA 时区名）
OVERSEAS_NEWS_SCHEDULE_TIMEZONE=Asia/Shanghai
# 当地小时和分钟（默认 07:00）
OVERSEAS_NEWS_SCHEDULE_HOUR=7
OVERSEAS_NEWS_SCHEDULE_MINUTE=0
# 抓取最近天数（1-7）
OVERSEAS_NEWS_SCHEDULE_CRAWL_DAYS=1
# 元数据任务超时（秒）
OVERSEAS_NEWS_JOB_TIMEOUT_SECONDS=1200
# 共享锁 TTL（秒，须大于任务超时）
OVERSEAS_NEWS_LOCK_TTL_SECONDS=1500
# 执行记录保留天数
OVERSEAS_NEWS_RUN_RETENTION_DAYS=90
# 是否启用当日漏跑补偿
OVERSEAS_NEWS_STARTUP_CATCHUP_ENABLED=true

# ── mcp-wewe 微信公众号 RSS（必填）───────────────
# WeWe RSS 服务地址
WEWE_RSS_URL=http://your-wewe-rss:4000
# WeWe RSS 认证码
WEWE_AUTH_CODE=your-auth-code-here

# ── mcp-crawl 海外安全新闻 ───────────────────────
# Tavily Search API Key（获取地址: https://tavily.com）
TAVILY_API_KEY=tvly-your-tavily-key-here

# ── 服务端口（可选，以下为默认值）────────────────
BACKEND_PORT=8000
# MCP_WEWE_URL=http://mcp-wewe:8100
# MCP_CRAWL_URL=http://mcp-crawl:8101
# MCP_CRAWL_API_KEY=replace-with-a-random-machine-token
# MCP_CRAWL_CONNECT_TIMEOUT=5
# MCP_CRAWL_READ_TIMEOUT=300
# MCP_CRAWL_MAX_RETRIES=2
# MCP_CRAWL_MAX_RESPONSE_MB=20
# MCP_CRAWL_VERIFY_TLS=true
# 独立爬虫 Bridge 资源保护（容器内配置）
# MCP_CRAWL_MAX_CONCURRENCY=2
# MCP_CRAWL_MAX_ARTICLES=500
# MCP_CRAWL_MAX_BATCH_URLS=100
# MCP_CRAWL_MAX_REQUEST_MB=5
# MCP_CRAWL_CORS_ORIGINS=http://192.168.1.10:8000

# ── 流水线配置（可选）────────────────────────────
# 触发 PR 报道的综合分阈值 (0-200)
PIPELINE_SCORE_THRESHOLD=140
# 默认爬取天数
PIPELINE_CRAWL_DEFAULT_DAYS=1

# ── 全链路执行日志（可选）──────────────────────────
EXECUTION_LOG_LEVEL=INFO
EXECUTION_LOG_RUN_RETENTION_DAYS=90
EXECUTION_LOG_EVENT_RETENTION_DAYS=30
EXECUTION_LOG_ERROR_RETENTION_DAYS=90
EXECUTION_LOG_DEBUG_RETENTION_DAYS=7
EXECUTION_LOG_QUEUE_SIZE=10000
EXECUTION_LOG_BATCH_SIZE=50
EXECUTION_LOG_FLUSH_INTERVAL_MS=500

# ── SearXNG 搜索（阶段十三）──────────────────────
# 功能总开关，灰度期间默认关闭
WEB_SEARCH_ENABLED=false
# SearXNG 内部地址（Docker Compose 自动生成，一般无需修改）
# SEARXNG_URL=http://searxng:8080
# SearXNG 连接超时秒数
SEARXNG_CONNECT_TIMEOUT=3
# SearXNG 搜索读取超时秒数
SEARXNG_READ_TIMEOUT=15
# 仅对连接错误、超时、502/503/504 重试
SEARXNG_MAX_RETRIES=1
# SearXNG 实例密钥（生产环境请替换为随机生成的强密钥）
SEARXNG_SECRET=your-searxng-secret-change-me
# 单页返回结果上限 (1-50)
WEB_SEARCH_RESULT_LIMIT=20
# 单批导入上限 (1-50)
WEB_SEARCH_IMPORT_BATCH_LIMIT=20
# 搜索会话保留时间分钟 (5-120)
WEB_SEARCH_SESSION_TTL_MINUTES=30
# 单用户搜索频率限制（次/分钟）
WEB_SEARCH_RATE_LIMIT_PER_MINUTE=20
# 后端允许的搜索分类
WEB_SEARCH_ALLOWED_CATEGORIES=general,news
# 后端允许的搜索语言
WEB_SEARCH_ALLOWED_LANGUAGES=all,zh-CN,en
# 导入后是否自动补全文
WEB_SEARCH_ENRICH_ON_IMPORT=true
# 全文抓取最大并发
WEB_SEARCH_FETCH_MAX_CONCURRENCY=3
# 导入审计保留天数
WEB_SEARCH_AUDIT_RETENTION_DAYS=180

# ── Agent Loop（阶段一）──────────────────────────────
# 总开关（默认关闭，灰度时开启）
CHAT_AGENT_ENABLED=false
# 问答 Agent 子开关（总开关开启后仍需单独开启）
CHAT_ASK_AGENT_ENABLED=false
# 改稿 Agent 子开关（ask 稳定后再开启）
CHAT_REVISE_AGENT_ENABLED=false
# 影子模式：后台执行 Agent 但不返回给用户
CHAT_AGENT_SHADOW_ENABLED=false
# 灰度百分比（0-100）
CHAT_AGENT_ROLLOUT_PERCENT=0
# Agent Loop 最大轮次
CHAT_AGENT_MAX_ROUNDS=5
# Agent Loop 输入 token 上限
CHAT_AGENT_MAX_INPUT_TOKENS=24000
# Agent Loop 输出 token 上限
CHAT_AGENT_MAX_OUTPUT_TOKENS=4000
# Agent Loop 最大工具调用次数
CHAT_AGENT_MAX_TOOL_CALLS=8
# 同轮最大并行工具数
CHAT_AGENT_MAX_PARALLEL_TOOLS=3
# Agent Loop 运行超时秒数
CHAT_AGENT_DEADLINE_SECONDS=30
# 单个工具执行超时秒数
CHAT_AGENT_TOOL_TIMEOUT_SECONDS=5
# Agent 事件保留天数
CHAT_AGENT_EVENT_TTL_DAYS=30
# 单次 Agent 运行成本上限（USD），0=不限制
CHAT_AGENT_MAX_COST_USD=0
# SSE 事件 schema 版本
CHAT_SSE_SCHEMA_VERSION=1.0

# ── 知识 Skills 与上下文工程（阶段二）──────────────────
# 知识 Skills/ContextManager 总开关（默认关闭）
KNOWLEDGE_SKILLS_ENABLED=false
# 影子模式：后台构建 ContextPlan 仅记录差异，LLM 仍用旧上下文
KNOWLEDGE_SKILLS_SHADOW_ENABLED=false
# 灰度百分比（0-100，按 user_id 确定性分流）
KNOWLEDGE_SKILLS_ROLLOUT_PERCENT=0
# 输入 token 上限；0=按模型窗口动态推导（不使用硬编码 8000 字符）
CONTEXT_MAX_INPUT_TOKENS=0
# 上下文缓存 TTL（秒，兜底）
CONTEXT_CACHE_TTL_SECONDS=300
# 离线上下文压缩开关（默认关闭）
CONTEXT_OFFLINE_COMPRESSION_ENABLED=false

# ── MultiAgent 编排（阶段三）──────────────────────────
# MultiAgent 编排总开关（默认关闭，灰度时开启）
MULTI_AGENT_ENABLED=false
# 影子模式：后台执行 planned 流水线仅记录差异，不回填业务产物
MULTI_AGENT_SHADOW_ENABLED=false
# 灰度百分比（0-100，按 user_id 确定性分流）
MULTI_AGENT_ROLLOUT_PERCENT=0
# Planner 小模型名；空=禁用 LLM 规划，直接默认 DAG
PLANNER_MODEL=
# Planner LLM 单次调用超时（秒）
PLANNER_TIMEOUT_SECONDS=10
# 计划最大步骤数
PLAN_MAX_STEPS=50
# 计划最大依赖深度
PLAN_MAX_DEPTH=10
# Orchestrator 全局最大并发 Worker
ORCHESTRATOR_MAX_CONCURRENCY=5
# 单用户最大并发 Worker
ORCHESTRATOR_USER_CONCURRENCY=2
# Worker 步骤租约 TTL（秒）
WORKER_LEASE_SECONDS=120
# Worker 最大尝试次数
WORKER_MAX_ATTEMPTS=3

# ── 全自主 Agent（阶段四 4A，默认关闭）─────────────────────
# 自主模式总开关（默认关闭；开启后仍独立于标准/AgentLoop，属第三条可选路径）
AUTONOMOUS_AGENT_ENABLED=false
# 影子运行：后台执行自主流程仅记录差异，不返回用户
AUTONOMOUS_AGENT_SHADOW_ENABLED=false
# 灰度百分比（0-100，按 user_id 确定性分流）
AUTONOMOUS_AGENT_ROLLOUT_PERCENT=0
# 以下预算上限默认已设置为安全值；开启总开关后若任一上限被改为 0，
# 配置校验会阻止自主模式启动（拒绝无上限运行）。
AUTONOMOUS_MAX_STEPS=20
AUTONOMOUS_MAX_RUNTIME_SECONDS=600
AUTONOMOUS_MAX_INPUT_TOKENS=24000
AUTONOMOUS_MAX_OUTPUT_TOKENS=4000
AUTONOMOUS_MAX_TOTAL_TOKENS=0
AUTONOMOUS_MAX_TOOL_CALLS=40
AUTONOMOUS_MAX_PARALLEL_TOOLS=3
AUTONOMOUS_MAX_TOOL_CONCURRENCY=3
AUTONOMOUS_MAX_COST_USD=0
AUTONOMOUS_MAX_RETRIES=2
AUTONOMOUS_MAX_CONSECUTIVE_FAILURES=3
AUTONOMOUS_LOOP_SIMILARITY_THRESHOLD=0.90
AUTONOMOUS_APPROVAL_TTL_SECONDS=1800
AUTONOMOUS_EVENT_TTL_DAYS=30
AUTONOMOUS_MODEL=deepseek-chat
# 模型路由回退链（逗号分隔）；空=不降级
AUTONOMOUS_ROUTER_FALLBACK_MODEL=
AUTONOMOUS_SSE_SCHEMA_VERSION=1.0
AUTONOMOUS_CONTEXT_MAX_CHARS=12000

# 前端统一 Agent 工作台；false 时默认回到旧仪表盘/对话入口
VITE_AGENT_WORKSPACE_ENABLED=true
