# 与主体服务使用同一个机器 Token；请勿提交真实值。
MCP_CRAWL_API_KEY=replace-with-the-same-random-machine-token
MCP_CRAWL_BIND_HOST=0.0.0.0
MCP_CRAWL_PORT=18101

MCP_CRAWL_IMAGE=pr-agent-mcp-crawl
MCP_CRAWL_IMAGE_TAG=latest
MCP_CRAWL_MAX_CONCURRENCY=2
MCP_CRAWL_MAX_ARTICLES=500
MCP_CRAWL_MAX_BATCH_URLS=100
MCP_CRAWL_MAX_REQUEST_MB=5
MCP_CRAWL_MAX_RESPONSE_MB=20

# 本机代理示例：http://host.docker.internal:7890
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
