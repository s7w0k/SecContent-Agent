# 本文件作为项目根目录 .env 的第二层覆盖配置使用。
BACKEND_PORT=18000
MONGO_HOST_PORT=37017

# V2 批量生成可能超过默认 10 分钟；仅影响 pr-core Worker。
ARQ_JOB_TIMEOUT=3600

MCP_CRAWL_URL=http://host.docker.internal:18101
MCP_CRAWL_API_KEY=replace-with-the-same-random-machine-token
MCP_CRAWL_CONNECT_TIMEOUT=5
MCP_CRAWL_READ_TIMEOUT=300
MCP_CRAWL_MAX_RETRIES=2
MCP_CRAWL_MAX_RESPONSE_MB=20
MCP_CRAWL_VERIFY_TLS=true

# 本地验证可复用已经构建的镜像；常规部署仍可使用 --build。
CORE_BACKEND_IMAGE=pr-agent-demo-backend:latest
CORE_WEWE_IMAGE=pr-agent-demo-mcp-wewe:latest
