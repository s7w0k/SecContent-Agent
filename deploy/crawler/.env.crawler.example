# 镜像版本：生产环境请固定不可变版本，不建议使用 latest
MCP_CRAWL_IMAGE=pr-agent-mcp-crawl
MCP_CRAWL_IMAGE_TAG=latest

# 使用以下命令生成至少 32 字节的独立机器 Token：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_CRAWL_API_KEY=replace-with-a-random-machine-token

# 默认仅允许爬虫宿主机访问；局域网部署改为 0.0.0.0 并配置防火墙白名单
MCP_CRAWL_BIND_HOST=127.0.0.1
MCP_CRAWL_PORT=8101

# Bridge 资源保护
MCP_CRAWL_MAX_CONCURRENCY=2
MCP_CRAWL_MAX_ARTICLES=500
MCP_CRAWL_MAX_BATCH_URLS=100
MCP_CRAWL_MAX_REQUEST_MB=5
MCP_CRAWL_MAX_RESPONSE_MB=20
MCP_CRAWL_PIDS_LIMIT=256
MCP_CRAWL_MEMORY_LIMIT=1g

# 服务间调用不需要浏览器 CORS；仅确有需要时填写逗号分隔的明确来源
MCP_CRAWL_CORS_ORIGINS=

# 可选代理方案一：代理运行在当前 Docker 宿主机
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# 可选代理方案二：代理位于局域网其他主机
# HTTP_PROXY=http://192.168.10.60:7890
# HTTPS_PROXY=http://192.168.10.60:7890
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

LOG_LEVEL=INFO
MCP_CRAWL_LOG_MAX_SIZE=20m
MCP_CRAWL_LOG_MAX_FILES=5
