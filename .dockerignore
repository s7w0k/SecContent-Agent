# ═══════════════════════════════════════════════════════════
# .dockerignore — 排除不必要的文件，减小构建上下文
# ═══════════════════════════════════════════════════════════

# ── Git ─────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Python ──────────────────────────────────────────
__pycache__
*.pyc
*.pyo
.python-version
.venv
venv
*.egg-info
dist
build
.pytest_cache
.mypy_cache
.ruff_cache
*.egg

# ── Node ────────────────────────────────────────────
node_modules
frontend/node_modules
frontend/dist
frontend/.vite

# ── IDE ─────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Env（保留模板，排除真实密钥）───────────────────
.env
.env.*
!.env.example

# ── Docs（挂载到容器，无需打入镜像）────────────────
docs/

# ── CI/CD ───────────────────────────────────────────
.gitee/
.github/

# ── Tests ───────────────────────────────────────────
tests/
.coverage
htmlcov
pytest.xml
coverage.xml

# ── 脚本 & 工具（不进入镜像）───────────────────────
scripts/
!scripts/
scripts/*
!scripts/migrate_local_user.py
!scripts/set_developer.py
*.sh
!*.py

# ── Misc ────────────────────────────────────────────
*.md
!README.md
.dockerignore
CLAUDE.md
.pre-commit-config.yaml
.secrets.baseline
.editorconfig
Makefile
docker-compose*.yml
